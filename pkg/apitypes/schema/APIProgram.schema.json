{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/APIProgram.schema.json",
  "$ref": "#/$defs/APIProgram",
  "$defs": {
    "APIInitiative": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "homeRepo": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "programName": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIProgram": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "initiatives": {
          "items": {
            "$ref": "#/$defs/APIInitiative"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}