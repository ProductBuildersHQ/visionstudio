{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/APIRelease.schema.json",
  "$ref": "#/$defs/APIRelease",
  "$defs": {
    "APIRelease": {
      "properties": {
        "id": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "releasedAt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "initiativeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}