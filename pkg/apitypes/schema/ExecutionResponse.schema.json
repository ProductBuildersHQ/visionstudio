{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/ExecutionResponse.schema.json",
  "$ref": "#/$defs/ExecutionResponse",
  "$defs": {
    "APIInitiative": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "homeRepo": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "programName": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIInitiativeDependency": {
      "properties": {
        "sourceInitiativeId": {
          "type": "string"
        },
        "targetInitiativeId": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIPhase": {
      "properties": {
        "id": {
          "type": "string"
        },
        "initiativeId": {
          "type": "string"
        },
        "sequenceNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIProgram": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "initiatives": {
          "items": {
            "$ref": "#/$defs/APIInitiative"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIRMI": {
      "properties": {
        "id": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "initiativeId": {
          "type": "string"
        },
        "phaseId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "sequenceNumber": {
          "type": "integer"
        },
        "claimedBy": {
          "type": "string"
        },
        "claimedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "tokensTotal": {
          "type": "integer"
        },
        "costUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIRMIDependency": {
      "properties": {
        "sourceRmiId": {
          "type": "string"
        },
        "targetRmiId": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIRepository": {
      "properties": {
        "id": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "repositoryName": {
          "type": "string"
        },
        "defaultBranch": {
          "type": "string"
        },
        "localPath": {
          "type": "string"
        },
        "goModule": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "APIStatusCount": {
      "properties": {
        "status": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ExecutionResponse": {
      "properties": {
        "programs": {
          "items": {
            "$ref": "#/$defs/APIProgram"
          },
          "type": "array"
        },
        "initiatives": {
          "items": {
            "$ref": "#/$defs/APIInitiative"
          },
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/APIPhase"
          },
          "type": "array"
        },
        "rmis": {
          "items": {
            "$ref": "#/$defs/APIRMI"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/APIRepository"
          },
          "type": "array"
        },
        "statusDistribution": {
          "items": {
            "$ref": "#/$defs/APIStatusCount"
          },
          "type": "array"
        },
        "rmiDependencies": {
          "items": {
            "$ref": "#/$defs/APIRMIDependency"
          },
          "type": "array"
        },
        "initiativeDependencies": {
          "items": {
            "$ref": "#/$defs/APIInitiativeDependency"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}