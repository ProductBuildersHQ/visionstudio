{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/NextSteps.schema.json",
  "$ref": "#/$defs/NextSteps",
  "$defs": {
    "ActionItem": {
      "properties": {
        "action": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "NextSteps": {
      "properties": {
        "rerunCommand": {
          "type": "string"
        },
        "immediate": {
          "items": {
            "$ref": "#/$defs/ActionItem"
          },
          "type": "array"
        },
        "recommended": {
          "items": {
            "$ref": "#/$defs/ActionItem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}