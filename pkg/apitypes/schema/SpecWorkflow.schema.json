{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/SpecWorkflow.schema.json",
  "$ref": "#/$defs/SpecWorkflow",
  "$defs": {
    "SpecWorkflow": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "specsRequired": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "specsOptional": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "initTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sequence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/SpecWorkflowPhase"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SpecWorkflowPhase": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "specs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}