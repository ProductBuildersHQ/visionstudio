{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionstudio.productbuildershq.com/api.schema.json",
  "$defs": {
    "APIInitiative": true,
    "APIInitiativeDependency": true,
    "APIPhase": true,
    "APIProgram": true,
    "APIRMI": true,
    "APIRMIDependency": true,
    "APIRepository": true,
    "APIStatusCount": true,
    "ActionItem": {
      "properties": {
        "action": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Annotation": {
      "properties": {
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "annotator_id": {
          "type": "string"
        },
        "annotator_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CategoryResult": {
      "properties": {
        "category": {
          "type": "string"
        },
        "score": {
          "type": "string"
        },
        "intScore": {
          "type": "integer"
        },
        "numericScore": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        },
        "severity": {
          "type": "string"
        },
        "reasonCodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reasoning": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "checklistResults": {
          "$ref": "#/$defs/ChecklistResults"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CategoryResultCounts": {
      "properties": {
        "pass": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "fail": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ChecklistResults": {
      "properties": {
        "requiredPresent": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requiredMissing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "optionalPresent": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "optionalMissing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ContextSpec": true,
    "CreateInitiativeRequest": true,
    "CreateInitiativeResponse": true,
    "Decision": {
      "properties": {
        "status": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "findingCounts": {
          "$ref": "#/$defs/FindingCounts"
        },
        "categoryCounts": {
          "$ref": "#/$defs/CategoryResultCounts"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ExecutionResponse": true,
    "Finding": {
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FindingCounts": {
      "properties": {
        "critical": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        },
        "info": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FindingLimits": {
      "properties": {
        "critical": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Initiative": true,
    "JudgeMetadata": {
      "properties": {
        "judge_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "prompt_template": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        },
        "rubric_id": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency": {
          "type": "integer"
        },
        "tokens_used": {
          "$ref": "#/$defs/TokenUsage"
        },
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JudgeResult": true,
    "NextSteps": {
      "properties": {
        "rerunCommand": {
          "type": "string"
        },
        "immediate": {
          "items": {
            "$ref": "#/$defs/ActionItem"
          },
          "type": "array"
        },
        "recommended": {
          "items": {
            "$ref": "#/$defs/ActionItem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PassCriteria": {
      "properties": {
        "minCategoriesPassing": {
          "type": "string"
        },
        "maxFindingsSeverity": {
          "$ref": "#/$defs/FindingLimits"
        },
        "minIntScore": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Phase": true,
    "Program": true,
    "ReferenceData": {
      "properties": {
        "id": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "expected_output": {
          "type": "string"
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ReportMetadata": {
      "properties": {
        "document": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "documentVersion": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatedBy": {
          "type": "string"
        },
        "reviewerId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RoadmapItem": true,
    "Rubric": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ReportMetadata"
        },
        "reviewType": {
          "type": "string"
        },
        "judge": {
          "$ref": "#/$defs/JudgeMetadata"
        },
        "rubricId": {
          "type": "string"
        },
        "rubricVersion": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ReferenceData"
        },
        "intScore": {
          "type": "integer"
        },
        "confidence": {
          "type": "number"
        },
        "pass": {
          "type": "boolean"
        },
        "blocking": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryResult"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "passCriteria": {
          "$ref": "#/$defs/PassCriteria"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "overallDecision": {
          "type": "string"
        },
        "nextSteps": {
          "$ref": "#/$defs/NextSteps"
        },
        "summary": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SpecFile": true,
    "SpecFilesResponse": true,
    "SpecWorkflow": true,
    "SpecWorkflowPhase": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "specs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SpecsResponse": true,
    "TokenUsage": {
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "total_tokens": {
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "WorkflowSpecDetail": true
  }
}